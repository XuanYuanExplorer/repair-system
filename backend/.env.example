# ---------- 基础 ----------
ENV=dev
DEBUG=false
TIMEZONE=Asia/Shanghai

# ---------- 数据库 ----------
# 默认 SQLite（零依赖）。生产 MySQL：
# DATABASE_URL=mysql+asyncmy://dorm:password@127.0.0.1:3306/dorm?charset=utf8mb4
DATABASE_URL=sqlite+aiosqlite:///./data/dorm.db

# ---------- 缓存（留空使用进程内实现；填 redis:// 则启用 Redis）----------
REDIS_URL=

# ---------- 认证（生产必须替换为 32 字节随机串，走密钥管理）----------
JWT_SECRET=dev-only-change-me-32bytes-secret-key
ACCESS_TOKEN_MINUTES=120
REFRESH_TOKEN_DAYS=7

# ---------- 上传 ----------
UPLOAD_DIR=./data/uploads
UPLOAD_BASE_URL=/uploads
MAX_IMAGE_MB=5
MAX_VIDEO_MB=20

# ---------- 外部网关（mock | aliyun / mock | wechat | campus）----------
SMS_PROVIDER=mock
PAY_PROVIDER=mock
PAY_EXPIRE_MINUTES=15

# ---------- 运行 ----------
AUTO_INIT=true
ENABLE_SCHEDULER=true
RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
